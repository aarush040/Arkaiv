# =============================================================================
# ARKAIV — Backend Environment Variables
# Copy this file to `.env` (same folder) and fill in the real values.
# =============================================================================

# --- Server ----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Frontend --------------------------------------------------------------
# Used by CORS and by the Google OAuth callback to redirect back to the SPA.
FRONTEND_URL=http://localhost:5173

# --- MongoDB Atlas ---------------------------------------------------------
# Connection string for your MongoDB Atlas cluster.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/arkaiv
MONGODB_URI=

# --- Google OAuth 2.0 (Passport.js) ---------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client (type: Web application)
# 2. Add this Authorized redirect URI:
#      http://localhost:3000/api/auth/google/callback
#    (replace with your production URL in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console exactly.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- JWT -------------------------------------------------------------------
# Used to sign access tokens. Use a long random string in production.
JWT_SECRET=replace-with-a-long-random-string
# Optional — used to sign refresh tokens. Falls back to a dev default
# (`arkaiv-refresh-secret-dev`) if unset, so this is recommended.
JWT_REFRESH_SECRET=replace-with-another-long-random-string

# --- Gemini AI (optional, for AI mentor) -----------------------------------
GEMINI_API_KEY=
